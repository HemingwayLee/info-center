# Copy to .env and fill in ONE of these. Docker Compose reads .env automatically.

# Claude Pro/Max subscription: run `claude setup-token` in your terminal and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# Or pay-as-you-go API billing with a key from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Integrations (MCP and /api/v1): the address other systems use to reach the backend, and how many answers
# may run at once (the rest wait). On a server, set PUBLIC_BASE_URL to its public HTTPS address.
PUBLIC_BASE_URL=http://localhost:8765
MAX_CONCURRENT_TURNS=3
